@model List<MediCart.Web.Models.MedicineViewModel>
@{
    ViewData["Title"] = "Browse medicines";
}

<link rel="stylesheet" href="~/css/medicine.css" asp-append-version="true" />

<div class="browse-page">

    <nav class="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span>/</span>
        <span class="current">Browse medicines</span>
    </nav>

    <div class="browse-layout">

        <!-- ===================== FILTER SIDEBAR ===================== -->
        <aside class="filters" id="filters">
            <div class="filters-head">
                <h3>Filters</h3>
                <button type="button" class="clear-btn" id="clearFilters">Clear all</button>
            </div>

            <div class="filter-group">
                <h4>Product type</h4>
                @foreach (var type in Model.Select(m => m.ProductType).Distinct().OrderBy(t => t))
                {
                    <label class="checkbox-row">
                        <input type="checkbox" class="filter-input" data-filter="type" value="@type" />
                        <span>@type</span>
                    </label>
                }
            </div>

            <div class="filter-group">
                <h4>Category</h4>
                @foreach (var cat in Model.Select(m => m.Category).Distinct().OrderBy(c => c))
                {
                    <label class="checkbox-row">
                        <input type="checkbox" class="filter-input" data-filter="category" value="@cat" />
                        <span>@cat</span>
                    </label>
                }
            </div>

            <div class="filter-group">
                <h4>Use tag</h4>
                @foreach (var tag in Model.SelectMany(m => m.UseTags).Distinct().OrderBy(t => t))
                {
                    <label class="checkbox-row">
                        <input type="checkbox" class="filter-input" data-filter="tag" value="@tag" />
                        <span>@tag</span>
                    </label>
                }
            </div>

            <div class="filter-group">
                <h4>Price range</h4>
                <input type="range" id="priceRange" min="0" max="500" step="5" value="500" class="price-slider" />
                <div class="price-range-labels">
                    <span>৳0</span>
                    <span id="priceRangeValue">৳500</span>
                </div>
            </div>
        </aside>

        <!-- ===================== RESULTS ===================== -->
        <section class="results">
            <div class="results-head">
                <h2 id="resultsTitle">Browse medicines <span id="resultsCount">(@Model.Count results)</span></h2>

                <div class="sort-wrap">
                    <label for="sortSelect">Sort:</label>
                    <select id="sortSelect">
                        <option value="popular">Most popular</option>
                        <option value="price-asc">Price: low to high</option>
                        <option value="price-desc">Price: high to low</option>
                        <option value="name-asc">Name: A–Z</option>
                    </select>
                </div>
            </div>

            <div class="medicine-grid" id="medicineGrid">
                @foreach (var med in Model)
                {
                    <article class="medicine-card"
                             data-id="@med.Id"
                             data-type="@med.ProductType"
                             data-category="@med.Category"
                             data-tags="@string.Join(",", med.UseTags)"
                             data-price="@med.Price"
                             data-name="@med.Name"
                             tabindex="0" role="button" aria-haspopup="dialog">
                        <div class="card-thumb">
                            <span class="pill-icon">@med.IconGlyph</span>
                            <button type="button" class="fav-btn" aria-label="Save to favourites" onclick="event.stopPropagation(); this.classList.toggle('active')">♥</button>
                        </div>

                        <div class="card-body">
                            <h3>@med.Name</h3>
                            <p class="generic-line">@med.GenericName &middot; @med.Manufacturer</p>

                            <div class="badge-row">
                                @if (med.RequiresPrescription)
                                {
                                    <span class="badge badge-rx">Rx required</span>
                                }
                                else
                                {
                                    <span class="badge @med.StockCss">@med.StockLabel</span>
                                }
                                <span class="badge badge-intensity">@med.Intensity</span>
                            </div>

                            <div class="card-footer">
                                <span class="price">৳ @med.Price.ToString("0")</span>
                                <button type="button" class="add-btn" data-id="@med.Id" aria-label="Add @med.Name to cart" onclick="event.stopPropagation()">+</button>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <p class="empty-state" id="emptyState" hidden>No medicines match these filters. Try clearing a few.</p>
        </section>
    </div>
</div>

<!-- ===================== QUICK VIEW MODAL ===================== -->
<div class="modal-backdrop" id="modalBackdrop" hidden>
    <div class="modal" id="medicineModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <button type="button" class="modal-close" id="modalClose" aria-label="Close">&times;</button>

        <div class="modal-thumb">
            <span class="pill-icon large" id="modalIcon">💊</span>
        </div>

        <div class="modal-content">
            <div class="badge-row" id="modalBadges"></div>
            <h2 id="modalTitle"></h2>
            <p class="generic-line" id="modalGeneric"></p>

            <p class="modal-desc" id="modalDesc"></p>

            <div class="modal-section">
                <h4>Dosage</h4>
                <p id="modalDosage"></p>
            </div>

            <div class="modal-section">
                <h4>Possible side effects</h4>
                <ul id="modalSideEffects" class="side-effects-list"></ul>
                <p class="disclaimer">This list isn't exhaustive. Stop use and consult a pharmacist or doctor if you notice anything unusual.</p>
            </div>

            <div class="modal-footer">
                <div class="qty-stepper">
                    <button type="button" id="qtyMinus" aria-label="Decrease quantity">−</button>
                    <span id="qtyValue">1</span>
                    <button type="button" id="qtyPlus" aria-label="Increase quantity">+</button>
                </div>
                <span class="modal-price" id="modalPrice"></span>
                <button type="button" class="add-btn-lg" id="modalAddBtn">Add to cart</button>
            </div>
        </div>
    </div>
</div>

<div class="toast" id="cartToast" hidden></div>

<!-- Data island: teammates can replace this with a fetch("/api/medicines") call later -->
<script id="medicines-data" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model))
</script>

<script src="~/js/medicine.js" asp-append-version="true"></script>

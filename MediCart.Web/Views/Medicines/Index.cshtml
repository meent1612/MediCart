@model List<MediCart.Web.Models.MedicineViewModel>
@using MediCart.Web.Models
@{
    ViewData["Title"] = "Browse medicines";
    var categories = (List<CategoryFilterOption>)(ViewBag.Categories ?? new List<CategoryFilterOption>());
    var productTypes = (List<ProductTypeFilterOption>)(ViewBag.ProductTypes ?? new List<ProductTypeFilterOption>());
    bool isAdmin = User.IsInRole("Admin");
}

@section Styles {
    <link rel="stylesheet" href="~/css/medicine.css" asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="container browse">

    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="~/">Home</a> <span>/</span> <span>Browse medicines</span>
    </nav>

    <div class="browse__layout">

        <aside class="filters" aria-label="Filters">
            <div class="filters__header">
                <h2>Filters</h2>
                <button type="button" class="filters__clear" id="clearFilters">Clear all</button>
            </div>

            <div class="filter-group">
                <h3>Product type</h3>
                <div class="filter-options" data-filter-group="productType">
                    @foreach (var pt in productTypes)
                    {
                        <label class="filter-check">
                            <input type="checkbox" value="@pt.Id" />
                            <span>@pt.Name</span>
                        </label>
                    }
                </div>
            </div>

            <div class="filter-group">
                <h3>Category</h3>
                <div class="filter-options" data-filter-group="category">
                    @foreach (var cat in categories)
                    {
                        <label class="filter-check">
                            <input type="checkbox" value="@cat.Id" />
                            <span>@cat.Name</span>
                        </label>

                        @if (cat.SubCategories.Any())
                        {
                            <div class="filter-options filter-options--sub" data-filter-group="subCategory">
                                @foreach (var sub in cat.SubCategories)
                                {
                                    <label class="filter-check filter-check--sub">
                                        <input type="checkbox" value="@sub.Id" />
                                        <span>@sub.Name</span>
                                    </label>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="filter-group">
                <h3>Price range</h3>
                <input type="range" id="priceRange" min="0" max="10000" step="100" value="10000" />
                <div class="filter-price-labels">
                    <span>৳0</span>
                    <span id="priceRangeValue">৳10000</span>
                </div>
            </div>
        </aside>

        <section class="results" aria-live="polite">
            <div class="results__toolbar">
                <div>
                    <h1 id="resultsHeading">All medicines</h1>
                    <span class="results__count" id="resultsCount">@Model.Count results</span>
                </div>
                <label class="sort">
                    Sort:
                    <select id="sortSelect">
                        <option value="name-asc" selected>Name: A to Z</option>
                        <option value="price-asc">Price: low to high</option>
                        <option value="price-desc">Price: high to low</option>
                    </select>
                </label>
            </div>

            <div class="product-grid" id="productGrid"
                 data-is-customer="@(User.IsInRole("Customer") ? "true" : "false")"
                 data-is-admin="@(isAdmin ? "true" : "false")"
                 data-login-url="/Identity/Account/Login">
                @foreach (var med in Model)
                {
                    <article class="product-card"
                             data-id="@med.Id"
                             data-name="@med.Name.ToLower()"
                             data-product-type-id="@med.ProductTypeId"
                             data-category-id="@med.CategoryId"
                             data-subcategory-id="@(med.SubCategoryId.HasValue ? med.SubCategoryId.Value.ToString() : "")"
                             data-price="@med.Price"
                             data-stock="@med.Stock">

                        <div class="product-card__image" aria-hidden="true">
                            @if (!string.IsNullOrWhiteSpace(med.ImageUrl))
                            {
                                <img src="@med.ImageUrl" alt="@med.Name" loading="lazy" />
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3.5" y="8.5" width="17" height="7" rx="3.5" transform="rotate(-45 12 12)" />
                                    <line x1="9.2" y1="14.8" x2="14.8" y2="9.2" />
                                </svg>
                            }
                        </div>

                        <div class="product-card__body">
                            <h3>@med.Name</h3>
                            <p class="product-card__sub">@med.Composition &middot; @med.Manufacturer</p>

                            <div class="product-card__badges">
                                @if (med.RequiresRx)
                                {
                                    <span class="badge badge--rx">Rx required</span>
                                }
                                else
                                {
                                    <span class="badge badge--stock-@med.StockCssClass">@med.StockStatus</span>
                                }
                            </div>

                            <div class="product-card__footer">
                                <span class="price">৳@med.Price.ToString("0")</span>

                                <div class="product-card__actions">
                                    <button type="button" class="btn-link view-details-btn" data-id="@med.Id">View details</button>
                                    @if (!isAdmin)
                                    {
                                        <button type="button" class="btn-add" data-id="@med.Id" aria-label="Add @med.Name to cart"
                                                @(med.Stock <= 0 ? "disabled" : "")>+</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <p class="no-results" id="noResults" hidden>No medicines match the selected filters.</p>
        </section>
    </div>
</div>

<!-- Detail modal -->
<div class="modal-overlay" id="modalOverlay" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <button type="button" class="modal__close" id="modalClose" aria-label="Close">&times;</button>

        <div class="modal__head">
            <div class="modal__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3.5" y="8.5" width="17" height="7" rx="3.5" transform="rotate(-45 12 12)" />
                    <line x1="9.2" y1="14.8" x2="14.8" y2="9.2" />
                </svg>
            </div>
            <div>
                <h2 id="modalTitle">Medicine name</h2>
                <p id="modalComposition" class="modal__composition">Composition</p>
            </div>
            <span class="badge badge--rx" id="modalRxBadge" hidden>Rx</span>
        </div>

        <div class="modal__grid">
            <div>
                <span class="modal__label">Manufacturer</span>
                <span class="modal__value" id="modalManufacturer"></span>
            </div>
            <div>
                <span class="modal__label">Form</span>
                <span class="modal__value" id="modalForm"></span>
            </div>
            <div>
                <span class="modal__label">Category</span>
                <span class="modal__value" id="modalCategory"></span>
            </div>
            <div>
                <span class="modal__label">Subcategory</span>
                <span class="modal__value" id="modalSubCategory"></span>
            </div>
            <div>
                <span class="modal__label">Pack / Unit</span>
                <span class="modal__value" id="modalUnit"></span>
            </div>
            <div>
                <span class="modal__label">In stock</span>
                <span class="modal__value" id="modalStock"></span>
            </div>
            <div>
                <span class="modal__label">Expiry date</span>
                <span class="modal__value" id="modalExpiry"></span>
            </div>
            <div>
                <span class="modal__label">Price</span>
                <span class="modal__value" id="modalPrice"></span>
            </div>
        </div>

        <div class="modal__section">
            <h4>Description</h4>
            <p id="modalDescription"></p>
        </div>

        <div class="modal__section">
            <h4>Dosage / Directions for use</h4>
            <p id="modalDosage"></p>
        </div>

        <div class="modal__section">
            <h4>Possible side effects</h4>
            <div class="modal__tags" id="modalSideEffects"></div>
        </div>

        <div class="modal__cart" hidden="@(isAdmin ? "hidden" : null)">
            <div class="qty-stepper">
                <button type="button" id="modalQtyMinus" aria-label="Decrease quantity">&minus;</button>
                <input type="number" id="modalQtyInput" value="1" min="1" max="99" aria-label="Quantity" />
                <button type="button" id="modalQtyPlus" aria-label="Increase quantity">+</button>
            </div>
            <button type="button" class="btn-add-cart" id="modalAddToCart">Add to cart</button>
        </div>
    </div>
</div>

<script type="application/json" id="medicineData">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => new
    {
        m.Id,
        m.Name,
        m.Composition,
        m.Manufacturer,
        m.ProductType,
        m.Category,
        m.SubCategory,
        m.Unit,
        m.Price,
        m.Stock,
        m.ExpiryDate,
        m.RequiresRx,
        StockStatus = m.StockStatus,
        m.Description,
        m.Dosage,
        m.SideEffects
    })))
</script>

@section Scripts {
    <script src="~/js/medicine.js" asp-append-version="true"></script>
}
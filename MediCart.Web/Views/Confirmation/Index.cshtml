@model MediCart.Web.Models.OrderConfirmationViewModel
@{
    ViewData["Title"] = "Order tracking";
}

@section Styles {
    <link rel="stylesheet" href="~/css/confirmation.css" asp-append-version="true" />
}

<div class="container confirmation-page">

    <ol class="step-tracker">
        <li class="step-tracker__step step-tracker__step--done">
            <span class="step-tracker__circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
            <span class="step-tracker__label">Cart</span>
        </li>
        <li class="step-tracker__step step-tracker__step--done">
            <span class="step-tracker__circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
            <span class="step-tracker__label">Checkout</span>
        </li>
        <li class="step-tracker__step step-tracker__step--active">
            <span class="step-tracker__circle">3</span>
            <span class="step-tracker__label">Confirmation</span>
        </li>
    </ol>

    <div class="tracking-card">
        <div class="tracking-card__head">
            <div>
                <h1>Order tracking</h1>
                <p class="tracking-card__meta">
                    ORDER #@Model.OrderNumber &middot; Placed @Model.PlacedAt
                    <button type="button" class="copy-order-btn" id="copyOrderBtn" data-order="@Model.OrderNumber" aria-label="Copy order number">Copy</button>
                </p>
            </div>
            <span class="status-badge">@Model.StatusLabel</span>
        </div>

        <ol class="tracking-progress">
            @for (var i = 0; i < Model.Stages.Count; i++)
            {
                var stage = Model.Stages[i];
                <li class="tracking-progress__step @(stage.IsDone ? "is-done" : "")">
                    <span class="tracking-progress__circle">
                        @if (stage.IsDone)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                        }
                        else
                        {
                            @(i + 1)
                        }
                    </span>
                    <span class="tracking-progress__label">@stage.Label</span>
                    <span class="tracking-progress__time">@stage.Timestamp</span>
                </li>
            }
        </ol>
    </div>

    <div class="confirmation-grid">
        <div class="confirmation-col">
            <section class="info-card">
                <h3>Delivery details</h3>
                <p class="info-card__name">@Model.CustomerName</p>
                <p>@Model.DeliveryAddress</p>
                <p>@Model.Phone</p>
            </section>

            @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
            {
                <section class="info-card">
                    <h3>Admin review note</h3>
                    <p>@Model.AdminNote</p>
                </section>
            }
        </div>

        <section class="info-card">
            <h3>Items</h3>
            <div class="items-list">
                @foreach (var item in Model.Items)
                {
                    <div class="items-list__row">
                        <span>@item.Name &times; @item.Quantity</span>
                        <span>৳@item.LineTotal.ToString("0")</span>
                    </div>
                }
                <div class="items-list__row">
                    <span>Delivery</span>
                    <span>৳@Model.DeliveryCharge.ToString("0")</span>
                </div>
                <div class="items-list__row items-list__row--total">
                    <span>Total</span>
                    <span>৳@Model.Total.ToString("0")</span>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/confirmation.js" asp-append-version="true"></script>
}

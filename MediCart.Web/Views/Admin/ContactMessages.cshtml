@model MediCart.Web.Models.AdminContactMessageListViewModel
@{
    ViewData["Title"] = "Contact messages";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-medicines.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-messages.css" asp-append-version="true" />
}

<div class="message-filter-bar">
    <form method="get" asp-action="ContactMessages">
        <label for="statusFilter">Status</label>
        <select id="statusFilter" name="status" onchange="this.form.submit()">
            <option value="Unread" selected="@(Model.StatusFilter == "Unread")">Unread</option>
            <option value="Read" selected="@(Model.StatusFilter == "Read")">Read</option>
            <option value="All" selected="@(Model.StatusFilter == "All")">All</option>
        </select>
    </form>
    <span class="medicine-results-count">@Model.UnreadCount unread &middot; @Model.TotalCount total</span>
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>From</th>
                <th>Email</th>
                <th>Message</th>
                <th>Received</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Messages.Count == 0)
            {
                <tr><td colspan="5" class="admin-table__muted">No messages match this filter.</td></tr>
            }
            @foreach (var msg in Model.Messages)
            {
                <tr class="@(!msg.IsRead ? "message-row--unread" : "")">
                    <td>@msg.Name</td>
                    <td>@msg.Email</td>
                    <td class="message-cell">@msg.Message</td>
                    <td>@msg.CreatedAt.ToLocalTime().ToString("dd MMM, h:mm tt")</td>
                    <td>
                        @if (!msg.IsRead)
                        {
                            <form method="post" asp-action="MarkMessageAsRead" asp-route-id="@msg.Id" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn--sm">Mark as read</button>
                            </form>
                        }
                        else
                        {
                            <span class="admin-table__muted">Read</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
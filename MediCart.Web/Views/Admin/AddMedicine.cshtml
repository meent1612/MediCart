@model MediCart.Web.Models.AdminMedicineFormPageViewModel
@{
    var isEdit = Model.Form.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit medicine" : "Add medicine";
    Layout = "_AdminLayout";
    var hasImage = !string.IsNullOrEmpty(Model.Form.ImageUrl);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-categories.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-medicine-form.css" asp-append-version="true" />
}

@if (TempData["MedicineSuccess"] != null)
{
    <div class="admin-alert admin-alert--success" data-alert data-auto-dismiss="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><path d="m22 4-10 10-3-3" /></svg>
        <span>@TempData["MedicineSuccess"]</span>
        <button type="button" class="admin-alert__dismiss" aria-label="Dismiss message">&times;</button>
    </div>
}
@if (TempData["MedicineError"] != null)
{
    <div class="admin-alert admin-alert--error" data-alert>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01" /><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" /></svg>
        <span>@TempData["MedicineError"]</span>
        <button type="button" class="admin-alert__dismiss" aria-label="Dismiss message">&times;</button>
    </div>
}

<div asp-validation-summary="ModelOnly" class="admin-alert admin-alert--error" role="alert"></div>

<section class="admin-panel admin-panel--wide">
    <div class="admin-panel__head">
        <h2>@(isEdit ? $"Edit — {Model.Form.Name}" : "Add a new medicine")</h2>
    </div>

    <form asp-action="@(isEdit ? "EditMedicine" : "AddMedicine")" method="post" id="medicineForm" enctype="multipart/form-data" novalidate>
        <input type="hidden" asp-for="Form.Id" />

        <div class="admin-form__section-label">Basic details</div>

        <div class="admin-form__row">
            <div class="admin-form__field">
                <label asp-for="Form.Name">Medicine name</label>
                <input asp-for="Form.Name" maxlength="150" required />
                <span asp-validation-for="Form.Name" class="admin-form__error"></span>
            </div>
            <div class="admin-form__field">
                <label asp-for="Form.Manufacturer">Manufacturer</label>
                <input asp-for="Form.Manufacturer" maxlength="100" />
            </div>
        </div>
        <div class="admin-form__row">
            <div class="admin-form__field">
                <label asp-for="Form.GenericName">Generic name</label>
                <input asp-for="Form.GenericName" maxlength="150" placeholder="e.g. Paracetamol + Caffeine" />
            </div>
            <div class="admin-form__field">
                <label asp-for="Form.Unit">Unit</label>
                <input asp-for="Form.Unit" maxlength="30" placeholder="e.g. Strip of 10 tablets" />
            </div>
        </div>
        <div class="admin-form__field">
            <label asp-for="Form.Description">Description</label>
            <textarea asp-for="Form.Description" rows="3" maxlength="1000" placeholder="What this medicine is used for..."></textarea>
        </div>

        <div class="admin-form__section-label">Image</div>

        <div class="admin-form__field">
            <div class="image-upload">
                <div class="image-upload__preview" id="imagePreviewBox">
                    @if (hasImage)
                    {
                        <img id="imagePreviewImg" src="@Model.Form.ImageUrl" alt="Medicine image preview" />
                    }
                    else
                    {
                        <span class="image-upload__placeholder" id="imagePreviewPlaceholder">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-5-5L5 21" /></svg>
                            No image yet
                        </span>
                    }
                    <button type="button" class="image-upload__clear" id="imageClearBtn" aria-label="Remove image" hidden="@(hasImage ? null : "hidden")">&times;</button>
                </div>

                <div class="image-upload__controls">
                    <div class="image-upload__row">
                        <label for="imageFileInput" class="btn btn--outline btn--sm">Choose image</label>
                        <span class="image-upload__filename" id="imageFileName">No file chosen</span>
                    </div>
                    <input type="file" id="imageFileInput" name="Form.ImageFile" accept="image/jpeg,image/png,image/webp" class="visually-hidden" />
                    <span asp-validation-for="Form.ImageFile" class="admin-form__error"></span>
                    <small class="admin-form__hint">JPG, PNG, or WEBP — under 5MB. Uploading replaces the current image.</small>

                    <div class="image-upload__divider"><span>or paste an image URL</span></div>

                    <input asp-for="Form.ImageUrl" type="url" maxlength="500" placeholder="https://..." id="imageUrlInput" />
                    <span asp-validation-for="Form.ImageUrl" class="admin-form__error"></span>
                </div>
            </div>
        </div>

        <div class="admin-form__section-label">Classification &amp; inventory</div>

        <div class="admin-form__row">
            <div class="admin-form__field">
                <label asp-for="Form.CategoryId">Category</label>
                <select asp-for="Form.CategoryId" id="Form_CategoryId" required>
                    <option value="">— Select category —</option>
                    @foreach (var opt in Model.CategoryOptions)
                    {
                        <option value="@opt.Id" selected="@(Model.Form.CategoryId == opt.Id ? "selected" : null)">@opt.Label</option>
                    }
                </select>
                <span asp-validation-for="Form.CategoryId" class="admin-form__error"></span>
            </div>
            <div class="admin-form__field">
                <label asp-for="Form.SubCategoryId">Subcategory <small class="admin-form__hint">(optional)</small></label>
                <select asp-for="Form.SubCategoryId" id="Form_SubCategoryId" data-selected="@Model.Form.SubCategoryId">
                    <option value="">— None —</option>
                </select>
                <span asp-validation-for="Form.SubCategoryId" class="admin-form__error"></span>
            </div>
        </div>

        <div class="admin-form__row">
            <div class="admin-form__field">
                <label asp-for="Form.ProductTypeId">Product type</label>
                <select asp-for="Form.ProductTypeId" required>
                    <option value="">— Select type —</option>
                    @foreach (var opt in Model.ProductTypeOptions)
                    {
                        <option value="@opt.Id" selected="@(Model.Form.ProductTypeId == opt.Id ? "selected" : null)">@opt.Label</option>
                    }
                </select>
                <span asp-validation-for="Form.ProductTypeId" class="admin-form__error"></span>
            </div>
            <div class="admin-form__field">
                <label asp-for="Form.Price">Price (৳)</label>
                <input asp-for="Form.Price" type="number" step="0.01" min="0.01" required />
                <span asp-validation-for="Form.Price" class="admin-form__error"></span>
            </div>
        </div>

        <div class="admin-form__row">
            <div class="admin-form__field">
                <label asp-for="Form.StockQuantity">Stock quantity</label>
                <input asp-for="Form.StockQuantity" type="number" min="0" required />
                <span asp-validation-for="Form.StockQuantity" class="admin-form__error"></span>
            </div>
            <div class="admin-form__field">
                <label asp-for="Form.ExpiryDate">Expiry date</label>
                <input asp-for="Form.ExpiryDate" type="date" required />
                <span asp-validation-for="Form.ExpiryDate" class="admin-form__error"></span>
            </div>
        </div>

        <div class="admin-form__field">
            <label asp-for="Form.SensitivityLevel">Sensitivity tier</label>
            <select asp-for="Form.SensitivityLevel">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Form.SensitivityLevel) ? "selected" : null)">Not sensitive</option>
                <option value="low" selected="@(Model.Form.SensitivityLevel == "low" ? "selected" : null)">Low (flags at 30+ units)</option>
                <option value="mid" selected="@(Model.Form.SensitivityLevel == "mid" ? "selected" : null)">Mid (flags at 15+ units)</option>
                <option value="high" selected="@(Model.Form.SensitivityLevel == "high" ? "selected" : null)">High (flags at 5+ units)</option>
            </select>
        </div>

        <div class="admin-form__section-label">Additional details</div>

        <div class="admin-form__field">
            <div class="toggle-row toggle-row--card">
                <div>
                    <strong>Requires a prescription</strong>
                    <p>Customers must upload a valid prescription image at checkout before this medicine can be ordered.</p>
                </div>
                <label class="switch">
                    <input asp-for="Form.RequiresPrescription" type="checkbox" />
                    <span class="switch__track"><span class="switch__thumb"></span></span>
                </label>
            </div>
        </div>

        <div class="admin-form__field">
            <div class="admin-form__side-effects-head">
                <label>Side effects</label>
                <button type="button" class="btn btn--outline btn--sm" id="addSideEffectBtn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                    Add side effect
                </button>
            </div>

            <p class="admin-form__empty-hint" id="sideEffectsEmpty" hidden="@(Model.Form.SideEffects.Count > 0 ? "hidden" : null)">
                No side effects added yet — click "+ Add side effect" to list one.
            </p>

            <div id="sideEffectsList" class="side-effects-list">
                @for (int i = 0; i < Model.Form.SideEffects.Count; i++)
                {
                    <div class="side-effect-row">
                        <input type="text" name="Form.SideEffects[@i].Effect" value="@Model.Form.SideEffects[i].Effect"
                               placeholder="e.g. Nausea" maxlength="150" />
                        <select name="Form.SideEffects[@i].Severity">
                            <option value="mild" selected="@(Model.Form.SideEffects[i].Severity == "mild" ? "selected" : null)">Mild</option>
                            <option value="moderate" selected="@(Model.Form.SideEffects[i].Severity == "moderate" ? "selected" : null)">Moderate</option>
                            <option value="severe" selected="@(Model.Form.SideEffects[i].Severity == "severe" ? "selected" : null)">Severe</option>
                        </select>
                        <button type="button" class="btn-link btn-link--danger remove-side-effect-btn">Remove</button>
                    </div>
                }
            </div>

            <template id="sideEffectRowTemplate">
                <div class="side-effect-row">
                    <input type="text" name="Form.SideEffects[__INDEX__].Effect" placeholder="e.g. Nausea" maxlength="150" />
                    <select name="Form.SideEffects[__INDEX__].Severity">
                        <option value="mild">Mild</option>
                        <option value="moderate">Moderate</option>
                        <option value="severe">Severe</option>
                    </select>
                    <button type="button" class="btn-link btn-link--danger remove-side-effect-btn">Remove</button>
                </div>
            </template>
        </div>

        <div class="admin-form__actions admin-form__actions--split">
            @if (isEdit)
            {
                <button type="button" id="deleteMedicineBtn" class="btn btn--outline btn--danger-outline"
                        data-id="@Model.Form.Id" data-name="@Model.Form.Name">
                    Delete medicine
                </button>
            }
            <div class="admin-form__actions-right">
                <a asp-action="Medicines" class="btn btn--outline">@(isEdit ? "Cancel edit" : "Cancel")</a>
                <button type="submit" class="btn btn--pine">@(isEdit ? "Save changes" : "Add medicine")</button>
            </div>
        </div>
    </form>
</section>

@if (isEdit)
{
    <div class="modal-overlay" id="deleteModalOverlay" aria-hidden="true">
        <div class="modal-card" role="alertdialog" aria-modal="true" aria-labelledby="deleteModalTitle" aria-describedby="deleteModalDesc">
            <h3 id="deleteModalTitle">Delete medicine?</h3>
            <p id="deleteModalDesc">This will permanently remove <strong id="deleteModalName">this medicine</strong> from your catalogue. This can't be undone.</p>
            <div class="modal-card__actions">
                <button type="button" class="btn btn--outline btn--sm" id="deleteModalCancel">Cancel</button>
                <button type="button" class="btn btn--danger btn--sm" id="deleteModalConfirm">Delete</button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/admin-medicine-form.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
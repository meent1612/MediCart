@model MediCart.Web.Models.AdminMedicinesPageViewModel
@{
    ViewData["Title"] = "Medicines";
    Layout = "_AdminLayout";
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.Search) || Model.CategoryId.HasValue || Model.SubCategoryId.HasValue || Model.ProductTypeId.HasValue;
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-categories.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-medicines.css" asp-append-version="true" />
}
@if (TempData["MedicineSuccess"] != null)
{
    <div class="admin-alert admin-alert--success" data-alert data-auto-dismiss="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><path d="m22 4-10 10-3-3" /></svg>
        <span>@TempData["MedicineSuccess"]</span>
        <button type="button" class="admin-alert__dismiss" aria-label="Dismiss message">&times;</button>
    </div>
}
@if (TempData["MedicineError"] != null)
{
    <div class="admin-alert admin-alert--error" data-alert>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01" /><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" /></svg>
        <span>@TempData["MedicineError"]</span>
        <button type="button" class="admin-alert__dismiss" aria-label="Dismiss message">&times;</button>
    </div>
}
<div class="admin-panel__head">
    <div>
        <h2>Medicines <span class="admin-count-pill">@Model.TotalCount</span></h2>
        <p class="admin-page-header__subtitle">Manage your pharmacy catalogue</p>
    </div>
    <a asp-action="AddMedicine" class="btn btn--pine btn--sm">+ Add medicine</a>
</div>

<div class="admin-toolbar-card">
    <form method="get" asp-action="Medicines" class="medicine-filter-bar" id="medicineFilterForm">
        <div class="admin-search medicine-filter-search-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
            <input type="text" name="search" id="medicineSearchInput" value="@Model.Search" placeholder="Search by name…" autocomplete="off" />
        </div>
        <select name="categoryId" id="filterCategory">
            <option value="">All categories</option>
            @foreach (var opt in Model.CategoryOptions)
            {
                <option value="@opt.Id" selected="@(Model.CategoryId == opt.Id ? "selected" : null)">@opt.Label</option>
            }
        </select>
        <select name="subCategoryId" id="filterSubCategory" data-selected="@Model.SubCategoryId">
            <option value="">All subcategories</option>
        </select>
        <select name="productTypeId" id="filterProductType">
            <option value="">All product types</option>
            @foreach (var opt in Model.ProductTypeOptions)
            {
                <option value="@opt.Id" selected="@(Model.ProductTypeId == opt.Id ? "selected" : null)">@opt.Label</option>
            }
        </select>
        <button type="submit" class="btn btn--outline btn--sm">Filter</button>
        @if (hasActiveFilters)
        {
            <a asp-action="Medicines" class="btn-link">Clear filters</a>
        }
    </form>
</div>

<p class="medicine-results-count" id="resultsCount" aria-live="polite">@Model.TotalCount medicine@(Model.TotalCount == 1 ? "" : "s") found</p>

<div class="admin-table-wrap" id="medicineTableWrap">
    @if (!Model.Medicines.Any())
    {
        <div class="admin-empty-state" style="padding: 48px 20px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
            </svg>
            <h3>No medicines match your filters</h3>
            <p>Try adjusting your search query or filter selections to find medicines.</p>
            @if (hasActiveFilters)
            {
                <a asp-action="Medicines" class="btn btn--outline btn--sm" style="margin-top: 12px;">Clear filters</a>
            }
        </div>
    }
    else
    {
        <table class="admin-table" id="medicineTable">
            <thead>
                <tr>
                    <th class="sort-th th--name" data-sort-key="name" data-sort-type="text" tabindex="0" role="button" aria-sort="none">
                        <span class="sort-th__label">Name
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                        </span>
                    </th>
                    <th class="th--category">Category</th>
                    <th class="th--subcategory">Sub-category</th>
                    <th class="th--type">Type</th>
                    <th class="th--manufacturer">Manufacturer</th>
                    <th class="sort-th sort-th--right th--price" data-sort-key="price" data-sort-type="number" tabindex="0" role="button" aria-sort="none">
                        <span class="sort-th__label">Price
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                        </span>
                    </th>
                    <th class="sort-th sort-th--right th--stock" data-sort-key="stock" data-sort-type="number" tabindex="0" role="button" aria-sort="none">
                        <span class="sort-th__label">Stock
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                        </span>
                    </th>
                    <th class="sort-th th--expiry" data-sort-key="expiry" data-sort-type="text" tabindex="0" role="button" aria-sort="none">
                        <span class="sort-th__label">Expiry
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                        </span>
                    </th>
                    <th class="th--sensitivity">Sensitivity</th>
                    <th class="th--actions"></th>
                </tr>
            </thead>
            <tbody>
                @{ var rowIndex = 0; }
                @foreach (var med in Model.Medicines)
                {
                    rowIndex++;
                    <tr class="med-row"
                        style="--row-index:@rowIndex"
                        data-name="@med.Name"
                        data-category="@med.CategoryName"
                        data-product-type="@med.ProductTypeName"
                        data-price="@med.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                        data-stock="@med.StockQuantity"
                        data-expiry="@med.ExpiryDate.ToString("yyyy-MM-dd")"
                        data-sensitivity="@(med.SensitivityLevel ?? "")"
                        data-rx="@(med.RequiresPrescription ? "true" : "false")">
                        <td data-label="Name" class="td--name">
                            <strong>@med.Name</strong>
                            @if (med.RequiresPrescription)
                            {
                                <div class="admin-table__sub"><span class="tag tag--rx">Rx</span></div>
                            }
                        </td>
                        <td data-label="Category" class="td--category">@med.CategoryName</td>
                        <td data-label="Sub-category" class="td--subcategory">
                            @if (!string.IsNullOrEmpty(med.SubCategoryName))
                            {
                                @med.SubCategoryName
                            }
                            else
                            {
                                <span class="admin-table__muted">—</span>
                            }
                        </td>
                        <td data-label="Type" class="td--type">@med.ProductTypeName</td>
                        <td data-label="Manufacturer" class="td--manufacturer" title="@(med.Manufacturer ?? "—")"><span>@(med.Manufacturer ?? "—")</span></td>
                        <td data-label="Price" class="td--price">৳@med.Price.ToString("0.00")</td>
                        <td data-label="Stock" class="td--stock stock-cell">
                            <div class="stock-cell-content">
                                @if (med.IsOutOfStock)
                                {
                                    <span class="stock-number stock-number--danger">0</span>
                                    <span class="tag tag--out-of-stock">Out of stock</span>
                                }
                                else if (med.IsLowStock)
                                {
                                    <span class="stock-number stock-number--warning">@med.StockQuantity</span>
                                    <span class="tag tag--low-stock">Low stock</span>
                                }
                                else
                                {
                                    <span class="stock-number">@med.StockQuantity</span>
                                }
                            </div>
                        </td>
                        <td data-label="Expiry" class="td--expiry expiry-cell-wrap">
                            @if (med.IsExpired)
                            {
                                <span class="expiry-date expiry-date--danger">@med.ExpiryDate.ToString("dd MMM yyyy")</span>
                                <span class="tag tag--expired">Expired</span>
                            }
                            else if (med.IsCriticalExpiry)
                            {
                                <span class="expiry-date expiry-date--danger">@med.ExpiryDate.ToString("dd MMM yyyy")</span>
                                <span class="tag tag--critical">Critical</span>
                            }
                            else if (med.IsWarningExpiry)
                            {
                                <span class="expiry-date expiry-date--warning">@med.ExpiryDate.ToString("dd MMM yyyy")</span>
                                <span class="tag tag--expiring-warn">Expires in @med.DaysUntilExpiry days</span>
                            }
                            else
                            {
                                <span class="expiry-date">@med.ExpiryDate.ToString("dd MMM yyyy")</span>
                            }
                        </td>
                        <td data-label="Sensitivity" class="td--sensitivity">
                            @if (!string.IsNullOrWhiteSpace(med.SensitivityLevel))
                            {
                                var sLevel = med.SensitivityLevel.Trim().ToLower();
                                var badgeClass = sLevel switch
                                {
                                    "low" or "mild" => "tag--sensitivity-low",
                                    "mid" or "moderate" => "tag--sensitivity-mid",
                                    "high" or "severe" => "tag--sensitivity-high",
                                    _ => "tag--sensitivity-mid"
                                };
                                var displayLabel = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(sLevel);
                                <span class="tag @badgeClass">@displayLabel</span>
                            }
                            else
                            {
                                <span class="admin-table__muted">—</span>
                            }
                        </td>
                        <td class="admin-table__actions td--actions">
                            <div class="admin-table__actions-wrap">
                                <a asp-action="EditMedicine" asp-route-id="@med.Id" class="btn-pill-action btn-pill-action--edit">Edit</a>
                                <form asp-action="DeleteMedicine" method="post" class="inline-form" id="deleteForm-@med.Id"
                                      onsubmit="return confirm('Delete this medicine permanently?');">
                                    <input type="hidden" name="id" value="@med.Id" />
                                    <button type="submit" class="btn-pill-action btn-pill-action--delete js-delete-trigger"
                                            data-form-id="deleteForm-@med.Id" data-medicine-name="@med.Name">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<div class="modal-overlay" id="deleteModalOverlay" aria-hidden="true">
    <div class="modal-card" role="alertdialog" aria-modal="true" aria-labelledby="deleteModalTitle" aria-describedby="deleteModalDesc">
        <h3 id="deleteModalTitle">Delete medicine?</h3>
        <p id="deleteModalDesc">This will permanently remove <strong id="deleteModalName">this medicine</strong> from your catalogue. This can't be undone.</p>
        <div class="modal-card__actions">
            <button type="button" class="btn btn--outline btn--sm" id="deleteModalCancel">Cancel</button>
            <button type="button" class="btn btn--danger btn--sm" id="deleteModalConfirm">Delete</button>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/admin-medicines.js" asp-append-version="true"></script>
}
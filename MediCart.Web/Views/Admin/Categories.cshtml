@model MediCart.Web.Models.AdminCategoriesViewModel
@{
    ViewData["Title"] = "Categories & Product Types";
    Layout = "_AdminLayout";

    var subCategoriesByParent = Model.SubCategories.ToLookup(sc => sc.CategoryId);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-categories.css" asp-append-version="true" />
}

@if (TempData["CategorySuccess"] != null)
{
    <div class="admin-alert admin-alert--success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
        <span>@TempData["CategorySuccess"]</span>
        <button type="button" class="admin-alert__dismiss" aria-label="Dismiss">&times;</button>
    </div>
}
@if (TempData["CategoryError"] != null)
{
    <div class="admin-alert admin-alert--error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16h.01" /></svg>
        <span>@TempData["CategoryError"]</span>
        <button type="button" class="admin-alert__dismiss" aria-label="Dismiss">&times;</button>
    </div>
}
@if (TempData["ProductTypeSuccess"] != null)
{
    <div class="admin-alert admin-alert--success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
        <span>@TempData["ProductTypeSuccess"]</span>
        <button type="button" class="admin-alert__dismiss" aria-label="Dismiss">&times;</button>
    </div>
}
@if (TempData["ProductTypeError"] != null)
{
    <div class="admin-alert admin-alert--error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16h.01" /></svg>
        <span>@TempData["ProductTypeError"]</span>
        <button type="button" class="admin-alert__dismiss" aria-label="Dismiss">&times;</button>
    </div>
}

<div class="admin-cat-grid">

    <!-- ============ Categories ============ -->
    <section class="admin-panel reveal in-view">
        <div class="admin-panel__head">
            <h2>Categories</h2>
            <button type="button" class="btn btn--pine btn--sm" id="newCategoryBtn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                New category
            </button>
        </div>

        <div class="admin-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
            <input type="text" id="categorySearch" placeholder="Search categories..." aria-label="Search categories" />
        </div>

        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Parent</th>
                        <th>Subcategories</th>
                        <th>Medicines</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="categoryTableBody">
                    @foreach (var cat in Model.Categories)
                    {
                        var children = subCategoriesByParent[cat.Id].ToList();
                        var hasChildren = children.Count > 0;

                        <tr class="cat-row cat-row--parent" data-id="@cat.Id" data-cat-name="@cat.Name.ToLower()">
                            <td>
                                <div class="cat-row__name">
                                    @if (hasChildren)
                                    {
                                        <button type="button" class="cat-toggle" data-parent-id="@cat.Id" aria-expanded="true" aria-label="Toggle subcategories">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="cat-toggle cat-toggle--spacer"></span>
                                    }
                                    <div>
                                        <strong>@cat.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(cat.Description))
                                        {
                                            <div class="admin-table__sub">@cat.Description</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td data-label="Parent">&mdash;</td>
                            <td data-label="Subcategories"><span class="count-pill @(cat.SubCategoryCount > 0 ? "count-pill--active" : "")">@cat.SubCategoryCount</span></td>
                            <td data-label="Medicines"><span class="count-pill @(cat.MedicineCount > 0 ? "count-pill--active" : "")">@cat.MedicineCount</span></td>
                            <td class="admin-table__actions">
                                <button type="button" class="btn-link edit-category-btn"
                                        data-id="@cat.Id" data-name="@cat.Name"
                                        data-description="@cat.Description" data-parent-id=""
                                        data-kind="category">
                                    Edit
                                </button>
                                <form asp-action="DeleteCategory" method="post" class="inline-form"
                                      onsubmit="return confirm('Delete this category?');">
                                    <input type="hidden" name="id" value="@cat.Id" />
                                    <button type="submit" class="btn-link btn-link--danger">Delete</button>
                                </form>
                            </td>
                        </tr>

                        @foreach (var child in children)
                        {
                            <tr class="cat-row cat-row--child" data-parent-id="@cat.Id" data-cat-name="@child.Name.ToLower()">
                                <td>
                                    <div class="cat-row__name cat-row__name--child">
                                        <span class="cat-connector" aria-hidden="true"></span>
                                        <div>
                                            <strong>@child.Name</strong>
                                            @if (!string.IsNullOrWhiteSpace(child.Description))
                                            {
                                                <div class="admin-table__sub">@child.Description</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Parent">@cat.Name</td>
                                <td data-label="Subcategories"><span class="count-pill">0</span></td>
                                <td data-label="Medicines"><span class="count-pill @(child.MedicineCount > 0 ? "count-pill--active" : "")">@child.MedicineCount</span></td>
                                <td class="admin-table__actions">
                                    <button type="button" class="btn-link edit-category-btn"
                                            data-id="@child.Id" data-name="@child.Name"
                                            data-description="@child.Description" data-parent-id="@child.CategoryId"
                                            data-kind="subcategory">
                                        Edit
                                    </button>
                                    <form asp-action="DeleteSubCategory" method="post" class="inline-form"
                                          onsubmit="return confirm('Delete this subcategory?');">
                                        <input type="hidden" name="id" value="@child.Id" />
                                        <button type="submit" class="btn-link btn-link--danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    @if (!Model.Categories.Any())
                    {
                        <tr id="categoriesEmptyRow">
                            <td colspan="5" class="admin-table__empty">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="1.5" /><path d="M3 9h18" /></svg>
                                <p>No categories yet. Add your first one below.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="admin-table__no-matches" id="categoryNoMatches" hidden>No categories match your search.</p>
        </div>

        <form asp-action="CreateCategory" method="post" class="admin-form admin-form--panel" id="categoryForm"
              data-had-error="@(TempData["CategoryError"] != null ? "true" : "false")" hidden>
            <input type="hidden" name="Id" id="categoryFormId" />
            <input type="hidden" name="Kind" id="categoryFormKind" value="category" />
            <h3 id="categoryFormTitle">Add a category</h3>

            <div class="admin-form__row">
                <div class="admin-form__field">
                    <label for="categoryName">Name</label>
                    <input type="text" id="categoryName" name="Name" required maxlength="100" pattern="[A-Za-z][A-Za-z\s']*"
                           title="Letters only — no numbers or symbols" />
                </div>
                <div class="admin-form__field">
                    <label for="categoryParent">Parent category (optional)</label>
                    <select id="categoryParent" name="ParentCategoryId">
                        <option value="">— None (top-level) —</option>
                        @foreach (var opt in Model.ParentCategoryOptions)
                        {
                            <option value="@opt.Id">@opt.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="admin-form__field">
                <label for="categoryDescription">Description (optional)</label>
                <textarea id="categoryDescription" name="Description" rows="2" maxlength="300"></textarea>
            </div>

            <div class="admin-form__actions">
                <button type="button" class="btn btn--outline" id="cancelCategoryEdit" hidden>Cancel edit</button>
                <button type="submit" class="btn btn--pine" id="categoryFormSubmit">Add category</button>
            </div>
        </form>
    </section>

    <!-- ============ Product Types ============ -->
    <section class="admin-panel reveal in-view">
        <div class="admin-panel__head">
            <h2>Product types</h2>
            <button type="button" class="btn btn--pine btn--sm" id="newProductTypeBtn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                New type
            </button>
        </div>

        <div class="admin-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
            <input type="text" id="productTypeSearch" placeholder="Search product types..." aria-label="Search product types" />
        </div>

        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Medicines</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="productTypeTableBody">
                    @foreach (var pt in Model.ProductTypes)
                    {
                        <tr class="pt-row" data-pt-name="@pt.Name.ToLower()">
                            <td><strong>@pt.Name</strong></td>
                            <td data-label="Medicines"><span class="count-pill @(pt.MedicineCount > 0 ? "count-pill--active" : "")">@pt.MedicineCount</span></td>
                            <td class="admin-table__actions">
                                <button type="button" class="btn-link edit-producttype-btn"
                                        data-id="@pt.Id" data-name="@pt.Name">
                                    Edit
                                </button>
                                <form asp-action="DeleteProductType" method="post" class="inline-form"
                                      onsubmit="return confirm('Delete this product type?');">
                                    <input type="hidden" name="id" value="@pt.Id" />
                                    <button type="submit" class="btn-link btn-link--danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.ProductTypes.Any())
                    {
                        <tr id="productTypesEmptyRow">
                            <td colspan="3" class="admin-table__empty">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="1.5" /><path d="M3 9h18" /></svg>
                                <p>No product types yet. Add your first one below.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="admin-table__no-matches" id="productTypeNoMatches" hidden>No product types match your search.</p>
        </div>

        <form asp-action="CreateProductType" method="post" class="admin-form admin-form--panel" id="productTypeForm"
              data-had-error="@(TempData["ProductTypeError"] != null ? "true" : "false")" hidden>
            <input type="hidden" name="Id" id="productTypeFormId" />
            <h3 id="productTypeFormTitle">Add a product type</h3>

            <div class="admin-form__field">
                <label for="productTypeName">Name</label>
                <input type="text" id="productTypeName" name="Name" required maxlength="50" pattern="[A-Za-z][A-Za-z\s/()'\-]*"
                       title="Letters only — no numbers" />
            </div>

            <div class="admin-form__actions">
                <button type="button" class="btn btn--outline" id="cancelProductTypeEdit" hidden>Cancel edit</button>
                <button type="submit" class="btn btn--pine" id="productTypeFormSubmit">Add type</button>
            </div>
        </form>
    </section>

</div>

@section Scripts {
    <script src="~/js/admin-categories.js" asp-append-version="true"></script>
}
@model MediCart.Web.Models.AdminProfileViewModel
@{
    ViewData["Title"] = "Admin profile";
    Layout = "_AdminLayout";
}

<div class="profile-grid">

    <!-- Left: identity card -->
    <section class="profile-card reveal in-view">
        <div class="profile-card__cover"></div>

        <div class="profile-card__avatar-wrap">
            <div class="admin-avatar admin-avatar--lg" id="avatarPreview">@Model.Initials</div>
            <button type="button" class="profile-card__avatar-edit" id="avatarEditBtn" aria-label="Change photo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
            </button>
            <input type="file" id="avatarInput" accept="image/png, image/jpeg" class="visually-hidden" />
        </div>
        <!-- Photo preview above is local-only for now — nothing saves it yet.
             TODO(backend): needs an AvatarUrl column on ApplicationUser plus
             a Cloudinary upload action, similar to how medicine images work. -->

        <h2 class="profile-card__name">@Model.FullName</h2>
        <span class="profile-card__role">@Model.RoleDisplay</span>

        <dl class="profile-card__meta">
            <div>
                <dt>Email</dt>
                <dd>@Model.Email</dd>
            </div>
            <div>
                <dt>Phone</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</dd>
            </div>
            <div>
                <dt>Joined</dt>
                <dd class="text-muted">Not available yet</dd>
            </div>
            <div>
                <dt>Last login</dt>
                <dd class="text-muted">Not available yet</dd>
            </div>
        </dl>

        <div class="profile-card__stats">
            <div>
                <strong class="text-muted">&mdash;</strong>
                <span>Orders reviewed</span>
            </div>
            <div>
                <strong class="text-muted">&mdash;</strong>
                <span>Medicines added</span>
            </div>
            <div>
                <strong class="text-muted">&mdash;</strong>
                <span>Flags resolved</span>
            </div>
        </div>
        <p class="profile-card__stats-note">Activity stats aren't tracked per-admin yet.</p>
    </section>

    <!-- Right: tabbed settings -->
    <section class="profile-panel reveal in-view">

        <div class="tabs" role="tablist" aria-label="Profile settings">
            <button class="tabs__btn is-active" role="tab" aria-selected="true" data-tab="info">Profile info</button>
            <button class="tabs__btn" role="tab" aria-selected="false" data-tab="notifications">Notifications</button>
            <button class="tabs__btn" role="tab" aria-selected="false" data-tab="activity">Recent activity</button>
        </div>

        <!-- Profile info -->
        <div class="tabs__panel is-active" data-panel="info" role="tabpanel">
            <form id="profileForm" class="admin-form" asp-controller="Admin" asp-action="UpdateProfile" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div class="admin-form__row">
                    <div class="admin-form__field">
                        <label for="fullName">Full name</label>
                        <input type="text" id="fullName" name="FullName" value="@Model.FullName" required />
                    </div>
                    <div class="admin-form__field">
                        <label>Role</label>
                        <input type="text" value="@Model.RoleDisplay" disabled />
                        <small class="admin-form__hint">Role changes aren't supported from this page yet.</small>
                    </div>
                </div>

                <div class="admin-form__row">
                    <div class="admin-form__field">
                        <label for="email">Email address</label>
                        <input type="email" id="email" value="@Model.Email" disabled />
                        <small class="admin-form__hint">Changing email requires a verification step that isn't wired up yet.</small>
                    </div>
                    <div class="admin-form__field">
                        <label for="phone">Phone number</label>
                        <input type="tel" id="phone" name="PhoneNumber" value="@Model.PhoneNumber" />
                    </div>
                </div>

                <div class="admin-form__field">
                    <label for="bio">Short bio</label>
                    <textarea id="bio" rows="3" placeholder="Not available yet" disabled></textarea>
                    <small class="admin-form__hint">No field for this in the database yet.</small>
                </div>

                <div class="admin-form__actions">
                    <button type="button" class="btn btn--outline" id="discardProfile">Discard</button>
                    <button type="submit" class="btn btn--pine">Save changes</button>
                </div>
            </form>
        </div>

        <!-- Notifications -->
        <div class="tabs__panel" data-panel="notifications" role="tabpanel" hidden>
            <p class="admin-form__hint" style="margin-bottom:16px;">
                These preferences aren't saved to the backend yet — toggling them here is visual only for now.
            </p>
            <div class="toggle-row">
                <div>
                    <strong>Flagged order alerts</strong>
                    <p>Email me immediately when a high-sensitivity order is flagged.</p>
                </div>
                <label class="switch"><input type="checkbox" checked /><span class="switch__track"><span class="switch__thumb"></span></span></label>
            </div>
            <div class="toggle-row">
                <div>
                    <strong>Low stock digest</strong>
                    <p>Daily summary of medicines nearing their stock threshold.</p>
                </div>
                <label class="switch"><input type="checkbox" checked /><span class="switch__track"><span class="switch__thumb"></span></span></label>
            </div>
            <div class="toggle-row">
                <div>
                    <strong>Expiry warnings</strong>
                    <p>Notify 30 days before a batch's expiry date.</p>
                </div>
                <label class="switch"><input type="checkbox" /><span class="switch__track"><span class="switch__thumb"></span></span></label>
            </div>
            <div class="toggle-row">
                <div>
                    <strong>New contact messages</strong>
                    <p>Notify when a customer submits the contact form.</p>
                </div>
                <label class="switch"><input type="checkbox" checked /><span class="switch__track"><span class="switch__thumb"></span></span></label>
            </div>
        </div>

        <!-- Recent activity -->
        <div class="tabs__panel" data-panel="activity" role="tabpanel" hidden>
            @if (Model.RecentActivity.Count == 0)
            {
                <p class="admin-form__hint">
                    No recent activity yet. Actions here will start appearing once
                    audit logging is added to the admin actions (add/edit/delete
                    medicine, category changes, order reviews, etc).
                </p>
            }
            else
            {
                <ul class="activity-list">
                    @foreach (var item in Model.RecentActivity)
                    {
                        <li>
                            <span class="activity-list__badge">@item.Action</span>
                            <div>
                                <p>
                                    @item.Action
                                    @if (!string.IsNullOrWhiteSpace(item.TableName))
                                    {
                                        <text> &mdash; @item.TableName</text>
                                    }
                                    @if (item.RecordId.HasValue)
                                    {
                                        <text> #@item.RecordId</text>
                                    }
                                </p>
                                <small>@item.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</small>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

    </section>
</div>

@section Scripts {
    <script src="~/js/admin-profile.js" asp-append-version="true"></script>
    <script>
        (function () {
            var success = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ProfileSuccess"]));
            var error = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ProfileError"]));
            if (success && window.showToast) window.showToast(success);
            if (error && window.showToast) window.showToast(error);
        })();
    </script>
}

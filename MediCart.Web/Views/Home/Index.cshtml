@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

@functions {
    // Maps a ProductType name to an inline SVG icon. Falls back to a
    // generic capsule glyph for any type not explicitly styled, so new
    // product types added in the admin panel don't break the layout.
    string ProductTypeIcon(string name)
    {
        return (name ?? "").Trim().ToLowerInvariant() switch
        {
            "tablet" => "<svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><rect x=\"3\" y=\"9\" width=\"18\" height=\"6\" rx=\"3\" transform=\"rotate(-45 12 12)\" /><path d=\"M9.5 14.5 14.5 9.5\" /></svg>",
            "syrup" => "<svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 2h6M10 2v6.34a2 2 0 0 1-.4 1.2L6.3 15a4 4 0 0 0-.8 2.4V20a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-2.6a4 4 0 0 0-.8-2.4l-3.3-5.46a2 2 0 0 1-.4-1.2V2\" /></svg>",
            "injection" => "<svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m18 2 4 4M17 7l-9 9-4 4-1-1 4-4 9-9zM12 6l6 6M9 9l6 6\" /></svg>",
            "ointment" => "<svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"6\" y=\"8\" width=\"12\" height=\"13\" rx=\"2\" /><path d=\"M9 8V5a3 3 0 0 1 6 0v3\" /></svg>",
            "drops" => "<svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z\" /></svg>",
            "capsule" => "<svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><rect x=\"2\" y=\"9\" width=\"20\" height=\"6\" rx=\"3\" /><path d=\"M12 9v6\" /></svg>",
            "cream" => "<svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3c3 3 5 5.5 5 9a5 5 0 0 1-10 0c0-3.5 2-6 5-9Z\" /><path d=\"M8 21h8\" /></svg>",
            "inhaler" or "spray" => "<svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 6h5a3 3 0 0 1 3 3v2H8z\" /><path d=\"M8 11v8a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2v-8\" /><path d=\"M17 8h2M17 11h3\" /></svg>",
            _ => "<svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><rect x=\"3\" y=\"9\" width=\"18\" height=\"6\" rx=\"3\" transform=\"rotate(-45 12 12)\" /><path d=\"M9.5 14.5 14.5 9.5\" /></svg>"
        };
    }

    // 1–2 letter monogram used on category avatars ("Skin Care" → "SC").
    string CategoryInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant()
            : (parts[0][0].ToString() + parts[1][0].ToString()).ToUpperInvariant();
    }
}

<div class="container">

    <!-- ==========================================================          HERO
         ============================================================ -->
    <section class="hero">
        <!-- Ambient animated gradient blobs -->
        <div class="hero__ambient" aria-hidden="true">
            <div class="hero__blob hero__blob--dark"></div>
            <div class="hero__blob hero__blob--primary"></div>
            <div class="hero__blob hero__blob--accent"></div>
        </div>

        <div class="hero__noise" aria-hidden="true"></div>

        <!-- Floating decorative shapes -->
        <span class="hero__floating-shape hero__floating-shape--1" aria-hidden="true"></span>
        <span class="hero__floating-shape hero__floating-shape--2" aria-hidden="true"></span>
        <span class="hero__floating-shape hero__floating-shape--3" aria-hidden="true"></span>

        <div class="hero__grid">
            <div class="hero__content">
                <p class="eyebrow">Admin-verified ordering</p>
                <div class="hero__pulse" aria-hidden="true">
                    <svg viewBox="0 0 220 32" fill="none" preserveAspectRatio="none">
                        <path class="hero__pulse-line" d="M0 16 H70 L82 4 L96 28 L108 8 L118 16 H220" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="hero__pulse-sweep"></span>
                </div>
                <h1 class="hero__headline">Every order is checked <em>before it ships</em>.</h1>
                <p class="hero__subcopy">
                    Browse a full pharmacy catalogue and order online — with a licensed pharmacist
                    reviewing every order, not just the ones tagged prescription-only.
                </p>

                <form id="heroSearchForm" class="hero__search" method="get" action="~/Medicines/Find" role="search">
                    <label for="heroSearchInput" class="visually-hidden">Search for a medicine</label>
                    <input type="search" id="heroSearchInput" name="search" class="hero__search-input" placeholder="Search for a medicine" autocomplete="off" />
                    <button type="submit" class="btn btn--search-hero">Search</button>
                </form>

                <div class="hero__chips" aria-label="Popular searches">
                    <span class="hero__chips-label">Popular:</span>
                    <a href="~/Medicines/Find?search=Napa+Extra" class="hero__chip">Napa Extra</a>
                    <a href="~/Medicines/Find?search=Seclo" class="hero__chip">Seclo</a>
                    <a href="~/Medicines/Browse?productType=Syrup" class="hero__chip">Cough syrup</a>
                    <a href="~/Medicines/Browse?search=Vitamin" class="hero__chip">Vitamins</a>
                </div>

                <div class="hero__actions">
                    <a href="~/Medicines" class="btn btn--hero-primary">Browse full catalogue &rarr;</a>
                    <button type="button" id="meetBaymaxBtn" class="btn btn--hero-ghost">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px; margin-right: 6px;"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                        Meet Baymax
                    </button>
                </div>
            </div>

            <div class="hero__right">
                <div class="hero__baymax-anchor" id="heroBaymaxAnchor">
                    <div class="hero__baymax-bubble" id="heroBaymaxBubble">
                        <span id="heroBaymaxBubbleText">Hello! I am Baymax.</span>
                    </div>
                    <div class="hero__baymax-lottie-wrap">
                        <div id="baymaxHeroLottie" class="hero__baymax-lottie"></div>
                    </div>
                    <div class="hero__verified-badge">
                        <span class="hero__verified-badge-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                        </span>
                        <div>
                            <span class="hero__verified-badge-title">Pharmacist Verified</span>
                            <span class="hero__verified-badge-sub">Every order checked before dispatch</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
         STATS / TRUST BAR
         ============================================================ -->
    <section class="stats-strip" aria-label="MediCart at a glance" id="statsStrip">
        <div class="stats-strip__item">
            <span class="stats-strip__number">500+</span>
            <span class="stats-strip__label">Verified medicines</span>
        </div>
        <div class="stats-strip__divider" aria-hidden="true"></div>
        <div class="stats-strip__item">
            <span class="stats-strip__number">100%</span>
            <span class="stats-strip__label">Pharmacist-reviewed orders</span>
        </div>
        <div class="stats-strip__divider" aria-hidden="true"></div>
        <div class="stats-strip__item">
            <span class="stats-strip__number">15,000+</span>
            <span class="stats-strip__label">Orders delivered</span>
        </div>
        <div class="stats-strip__divider" aria-hidden="true"></div>
        <div class="stats-strip__item">
            <span class="stats-strip__number">24/7</span>
            <span class="stats-strip__label">Dedicated support</span>
        </div>
    </section>

    <!-- ============================================================
         SHOP BY TYPE
         ============================================================ -->
    <section class="section">
        <div class="section__head">
            <p class="eyebrow">Shop by type</p>
            <h2>Browse by product type</h2>
            <p>Every medicine on MediCart is organised by type, category and use — same as it would be behind the pharmacy counter.</p>
        </div>

        <div class="category-grid">
            @{
                var productTypes = ViewBag.ProductTypes as List<MediCart.Web.Models.ProductTypeFilterOption>;
            }
            @if (productTypes != null && productTypes.Any())
            {
                foreach (var pt in productTypes)
                {
                    <a href="~/Medicines/Browse?productType=@Uri.EscapeDataString(pt.Name)" class="category-card">
                        <span class="category-card__icon">@Html.Raw(ProductTypeIcon(pt.Name))</span>
                        <span class="category-card__label">@pt.Name</span>
                    </a>
                }
            }
            else
            {
                <p class="empty-note">No product types available yet.</p>
            }
        </div>
    </section>

    <!-- ============================================================
         SHOP BY CATEGORY
         ============================================================ -->
    <section class="section section--alt">
        <div class="section__head">
            <p class="eyebrow">Shop by category</p>
            <h2>Browse by category</h2>
            <p>Find medicines the way you'd ask for them in person — by category, then by exactly what you need within it.</p>
        </div>

        <div class="shop-category-grid">
            @{
                var categories = ViewBag.Categories as List<MediCart.Web.Models.CategoryFilterOption>;
            }
            @if (categories != null && categories.Any())
            {
                foreach (var cat in categories)
                {
                    <a href="~/Medicines/Browse?category=@Uri.EscapeDataString(cat.Name)" class="shop-category-card">
                        <span class="shop-category-card__avatar shop-category-card__avatar--@(cat.Id % 5)">
                            @CategoryInitials(cat.Name)
                        </span>
                        <span class="shop-category-card__name">@cat.Name</span>
                        @if (cat.SubCategories.Any())
                        {
                            <span class="shop-category-card__subs">
                                @string.Join(" · ", cat.SubCategories.Take(3).Select(s => s.Name))@(cat.SubCategories.Count > 3 ? $" +{cat.SubCategories.Count - 3} more" : "")
                            </span>
                        }
                        else
                        {
                            <span class="shop-category-card__subs shop-category-card__subs--muted">View products</span>
                        }
                    </a>
                }
            }
            else
            {
                <p class="empty-note">No categories available yet.</p>
            }
        </div>
    </section>

    <!-- ============================================================
         HOW IT WORKS
         ============================================================ -->
    <section class="section section--alt" id="howItWorksSection">
        <div class="section__head">
            <p class="eyebrow">How it works</p>
            <h2>From cart to doorstep, reviewed at every step</h2>
            <p>Ordering medicine online shouldn't feel risky. Here's what happens behind the scenes with every MediCart order.</p>
        </div>

        <div class="steps">

            <div class="step">
                <span class="step__number">1</span>
                <span class="step__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
                </span>
                <h3>Search &amp; add to cart</h3>
                <p>Find what you need by name, type or category, and add it to your cart in a couple of taps.</p>
            </div>

            <div class="step">
                <span class="step__number">2</span>
                <span class="step__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 21a8 8 0 1 0-16 0" /><circle cx="12" cy="7" r="4" /></svg>
                </span>
                <h3>Pharmacist reviews it</h3>
                <p>Every order — not only prescription items — is checked by a pharmacist before it's approved.</p>
            </div>

            <div class="step">
                <span class="step__number">3</span>
                <span class="step__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="7" width="15" height="13" rx="2" /><path d="M16 10h3.5a1 1 0 0 1 .9.55L23 14v6h-7" /><circle cx="6" cy="20" r="1.6" /><circle cx="17.5" cy="20" r="1.6" /></svg>
                </span>
                <h3>Delivered to your door</h3>
                <p>Once approved, your order ships and you can track it right from your account.</p>
            </div>
        </div>
    </section>

    <!-- ============================================================
         FEATURED / FREQUENTLY ORDERED
         ============================================================ -->
    <section class="section">
        <div class="section__head">
            <p class="eyebrow">Featured</p>
            <h2>Frequently ordered</h2>
            <p>Popular, in-stock medicines this week.</p>
        </div>

        <div class="product-grid">
            @{
                var frequentlyOrdered = ViewBag.FrequentlyOrdered as List<MediCart.Web.Data.Medicine>;
            }
            @if (frequentlyOrdered != null && frequentlyOrdered.Any())
            {
                foreach (var med in frequentlyOrdered)
                {
                    var genericWithDosage = string.Join(" ", new[] { med.GenericName, med.Dosage }.Where(s => !string.IsNullOrWhiteSpace(s)));
                    var meta = string.Join(" · ", new[] { genericWithDosage, med.ProductType?.Name }.Where(s => !string.IsNullOrWhiteSpace(s)));
                    if (string.IsNullOrWhiteSpace(meta))
                    {
                        meta = med.Manufacturer ?? "Medicine";
                    }

                    <article class="product-card">
                        <div class="product-card__media">
                            @if (!string.IsNullOrWhiteSpace(med.ImageUrl))
                            {
                                <img src="@med.ImageUrl" alt="@med.Name" loading="lazy" style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                @Html.Raw(ProductTypeIcon(med.ProductType?.Name ?? ""))
                            }
                        </div>
                        <div class="product-card__body">
                            <span class="product-card__name">@med.Name</span>
                            <span class="product-card__meta">@meta</span>
                            <div class="product-card__tags">
                                @if (med.RequiresPrescription)
                                {
                                    <span class="tag tag--rx">Rx required</span>
                                }
                                else
                                {
                                    <span class="tag tag--stock">In stock</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(med.SensitivityLevel) && med.SensitivityLevel.Equals("High", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="tag tag--high">High sensitivity</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(med.SensitivityLevel))
                                {
                                    <span class="tag tag--mild">Mild severity</span>
                                }
                            </div>
                            <div class="product-card__footer">
                                <span class="product-card__price">&#2547; @(med.Price % 1 == 0 ? med.Price.ToString("0") : med.Price.ToString("0.00"))</span>
                                @if (!User.IsInRole("Admin"))
                                {
                                    <button type="button" class="add-btn" aria-label="Add @med.Name to cart" data-id="@med.Id">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="add-btn add-btn--admin-disabled" data-id="@med.Id" title="Admins cannot place orders" aria-label="Admins cannot place orders" aria-disabled="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                                    </button>
                                }
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
    </section>

    <!-- ============================================================
         TESTIMONIALS
         ============================================================ -->
    <section class="section" id="testimonialsSection">
        <div class="section__head">
            <p class="eyebrow">Customer reviews</p>
            <h2>Trusted by our customers</h2>
            <p>Real stories from patients and families who count on MediCart for verified, on-time pharmacy deliveries.</p>
        </div>

        <div class="testimonials-grid">
            <div class="testimonial-card">
                <span class="testimonial-card__tag">Sample review</span>
                <div class="testimonial-card__quote">
                    &ldquo;Knowing a licensed pharmacist reviews every prescription before dispatch gives me complete peace of mind. Delivery was prompt and discreet.&rdquo;
                </div>
                <div class="testimonial-card__author">
                    <span class="testimonial-card__avatar testimonial-card__avatar--green">RA</span>
                    <div class="testimonial-card__info">
                        <span class="testimonial-card__name">Rahim Ahmed</span>
                        <span class="testimonial-card__role">Verified Patient · Dhaka</span>
                    </div>
                </div>
            </div>

            <div class="testimonial-card">
                <span class="testimonial-card__tag">Sample review</span>
                <div class="testimonial-card__quote">
                    &ldquo;I reorder my parents' hypertension and diabetes medicines monthly. The expiry dates are always well in the future and packaging is completely sealed.&rdquo;
                </div>
                <div class="testimonial-card__author">
                    <span class="testimonial-card__avatar testimonial-card__avatar--pink">SK</span>
                    <div class="testimonial-card__info">
                        <span class="testimonial-card__name">Sadia Karim</span>
                        <span class="testimonial-card__role">Verified Customer · Narayanganj</span>
                    </div>
                </div>
            </div>

            <div class="testimonial-card">
                <span class="testimonial-card__tag">Sample review</span>
                <div class="testimonial-card__quote">
                    &ldquo;Finding pediatric syrups and inhalers used to be a hassle. MediCart's catalogue is organized cleanly and the search is instantaneous.&rdquo;
                </div>
                <div class="testimonial-card__author">
                    <span class="testimonial-card__avatar testimonial-card__avatar--dark">TH</span>
                    <div class="testimonial-card__info">
                        <span class="testimonial-card__name">Tanvir Hossain</span>
                        <span class="testimonial-card__role">Verified Customer · Chattogram</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
         CLOSING CTA (guests only — signed-in users already have an account)
         ============================================================ -->
    @if (User.Identity?.IsAuthenticated != true)
    {
        <section class="cta-banner">
            <div class="cta-banner__noise" aria-hidden="true"></div>
            <h2>Ready to order with confidence?</h2>
            <p>Create a free account to track orders, save your details, and check out faster next time.</p>
            <div class="cta-banner__actions">
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn--amber">Create an account</a>
                <a href="~/Medicines" class="btn btn--outline-light">Browse medicines</a>
            </div>
        </section>
    }

</div>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}

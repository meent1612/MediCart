@model MediCart.Web.Models.AdminFlaggedOrdersListViewModel
@{
    ViewData["Title"] = "Flagged orders";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-medicines.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-orders.css" asp-append-version="true" />
}

<div class="admin-page-header">
    <h2 class="admin-page-header__title">Flagged orders</h2>
    <p class="admin-page-header__subtitle">Orders flagged for prescription verification or high-quantity review</p>
</div>

<div class="admin-toolbar-card">
    <div class="order-filter-bar">
        <form method="get" asp-action="FlaggedOrders" style="display: flex; align-items: center; gap: 10px;">
            <label for="tierFilter">Tier</label>
            <select id="tierFilter" name="tier" onchange="this.form.submit()">
                <option value="All" selected="@(Model.TierFilter == "All")">All</option>
                <option value="High" selected="@(Model.TierFilter == "High")">High</option>
                <option value="Mid" selected="@(Model.TierFilter == "Mid")">Mid</option>
                <option value="Low" selected="@(Model.TierFilter == "Low")">Low</option>
            </select>
        </form>
    </div>
    <span class="admin-toolbar-count">@Model.TotalCount flagged order(s)</span>
</div>

<div class="admin-table-wrap">
    @if (Model.Orders.Count == 0)
    {
        <div class="admin-empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 21V4a1 1 0 0 1 1-1h10l4 4v9a1 1 0 0 1-1 1H6"/>
            </svg>
            <h3>No flagged orders found</h3>
            <p>Try changing the tier filter above.</p>
        </div>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Flagged items</th>
                    <th>Placed</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td><strong>@order.OrderNumber</strong></td>
                        <td>@order.CustomerName</td>
                        <td><span class="order-status-badge order-status-badge--@order.Status.ToLower()">@order.Status</span></td>
                        <td>
                            <ul class="flagged-items-list">
                                @foreach (var item in order.FlaggedItems)
                                {
                                    <li>
                                        <span class="tag tag--sensitivity-@item.SensitivityLevel">@item.SensitivityLevel</span>
                                        @item.MedicineName &mdash; ordered @item.Quantity (threshold @item.Threshold)
                                    </li>
                                }
                            </ul>
                        </td>
                        <td>@order.CreatedAt.ToLocalTime().ToString("dd MMM, h:mm tt")</td>
                        <td style="text-align: right;">
                            <a class="btn-pill-view" asp-action="OrderDetail" asp-route-id="@order.Id">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
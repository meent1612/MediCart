@model MediCart.Web.Models.UserProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/userprofile.css" asp-append-version="true" />
}

<div class="up-page">
    <div class="up-shell">

        <!-- ===== Sidebar ===== -->
        <aside class="up-sidebar">
            <div class="up-sidebar__identity">
                <span class="up-avatar">
                    @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                </span>
                <strong>@Model.FullName</strong>
                <span class="up-sidebar__email">@Model.Email</span>
            </div>

            <nav class="up-nav">
                <a href="#profile-details" class="up-nav__link">Profile details</a>
                <a href="#order-history" class="up-nav__link is-active">Order history</a>
                <a href="#" class="up-nav__link">Saved address</a>
                <a asp-area="Identity" asp-page="/Account/Logout" class="up-nav__link up-nav__link--logout">Log out</a>
            </nav>
        </aside>

        <!-- ===== Main content ===== -->
        <main class="up-main">

            <!-- Order history -->
            <section class="up-card" id="order-history">
                <h2>Order history</h2>
                <p class="up-card__sub">All orders placed from your account.</p>

                @if (Model.Orders.Any())
                {
                    <div class="up-table-wrap">
                        <table class="up-table">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Date</th>
                                    <th>Items</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.Orders)
                                {
                                    var statusClass = order.Status switch
                                    {
                                        "Shipped" => "up-status up-status--shipped",
                                        "Delivered" => "up-status up-status--delivered",
                                        "Pending review" => "up-status up-status--pending",
                                        "Rejected" => "up-status up-status--rejected",
                                        _ => "up-status"
                                    };
                                    <tr>
                                        <td class="up-table__mono">@order.OrderId</td>
                                        <td>@order.Date.ToString("dd MMM yyyy")</td>
                                        <td>@order.ItemCount item@(order.ItemCount != 1 ? "s" : "")</td>
                                        <td class="up-table__mono">৳ @order.Total.ToString("N0")</td>
                                        <td><span class="@statusClass">@order.Status</span></td>
                                        <td><a href="#" class="up-table__view">View →</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="up-empty">You haven't placed any orders yet.</p>
                }
            </section>

            <!-- Profile details -->
            <section class="up-card" id="profile-details">
                <h2>Profile details</h2>
                <p class="up-card__sub">Keep your contact information up to date for delivery.</p>

                @if (TempData["ProfileSuccess"] != null)
                {
                    <div class="up-success">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5" /></svg>
                        <span>@TempData["ProfileSuccess"]</span>
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="up-error-summary" role="alert"></div>

                <form asp-action="Index" method="post" class="up-form" novalidate>
                    <div class="up-form__row">
                        <div class="up-field">
                            <label asp-for="FullName">Full name</label>
                            <input asp-for="FullName" />
                            <span asp-validation-for="FullName" class="up-field__error"></span>
                        </div>
                        <div class="up-field">
                            <label asp-for="PhoneNumber">Phone number</label>
                            <input asp-for="PhoneNumber" placeholder="01XXX-XXXXXX" />
                            <span asp-validation-for="PhoneNumber" class="up-field__error"></span>
                        </div>
                    </div>

                    <div class="up-field">
                        <label asp-for="Email">Email address</label>
                        <input asp-for="Email" />
                        <span asp-validation-for="Email" class="up-field__error"></span>
                    </div>

                    <button type="submit" class="btn btn--pine">Save changes</button>
                </form>
            </section>

        </main>
    </div>
</div>
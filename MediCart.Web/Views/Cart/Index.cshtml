@model List<MediCart.Web.Models.CartItemViewModel>
@{
    ViewData["Title"] = "Your cart";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
}

<div class="container cart-page">

    <ol class="step-tracker">
        <li class="step-tracker__step step-tracker__step--active">
            <span class="step-tracker__circle">1</span>
            <span class="step-tracker__label">Cart</span>
        </li>
        <li class="step-tracker__step">
            <span class="step-tracker__circle">2</span>
            <span class="step-tracker__label">Checkout</span>
        </li>
        <li class="step-tracker__step">
            <span class="step-tracker__circle">3</span>
            <span class="step-tracker__label">Confirmation</span>
        </li>
    </ol>

    <h1 id="cartHeading">Your cart (@Model.Count item@(Model.Count == 1 ? "" : "s"))</h1>

    @if (TempData["CheckoutError"] != null)
    {
        <div class="cart-alert cart-alert--error" id="checkoutErrorBanner">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
                <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <span>@TempData["CheckoutError"]</span>
        </div>
    }

    <div class="cart-layout">

        <section class="cart-items" id="cartItems">
            @foreach (var item in Model)
            {
                <article class="cart-item"
                    data-id="@item.Id"
                    data-medicine-id="@item.MedicineId"
                    data-price="@item.UnitPrice"
                    data-requires-rx="@item.RequiresRx.ToString().ToLower()"
                    data-available-stock="@item.AvailableStock"
                    data-is-expired="@item.IsExpired.ToString().ToLower()"
                    data-is-critical="@item.IsCriticalExpiry.ToString().ToLower()"
                    data-is-warning="@item.IsWarningExpiry.ToString().ToLower()">

                    <div class="cart-item__icon" aria-hidden="true">
                        @if (item.IconType == "bottle")
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 2h6v3.4c0 .5.2 1 .6 1.4L17 8.4V20a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V8.4l1.4-1.6c.4-.4.6-.9.6-1.4V2Z" />
                                <line x1="8.6" y1="11" x2="15.4" y2="11" />
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3.5" y="8.5" width="17" height="7" rx="3.5" transform="rotate(-45 12 12)" />
                                <line x1="9.2" y1="14.8" x2="14.8" y2="9.2" />
                            </svg>
                        }
                    </div>

                    <div class="cart-item__body">
                        <h3>@item.Name</h3>
                        <p class="cart-item__desc">@item.Description</p>

                        @* Badge priority: Expired → Critical → Warning → Out of stock → Rx → In stock *@
                        @if (item.IsExpired)
                        {
                            <span class="badge badge--danger">Expired — remove to proceed to checkout</span>
                        }
                        else if (item.IsCriticalExpiry)
                        {
                            <span class="badge badge--danger">Expires in @item.DaysUntilExpiry day(s) — remove to proceed</span>
                        }
                        else if (item.IsWarningExpiry)
                        {
                            <span class="badge badge--warning">Expires in @item.DaysUntilExpiry days</span>
                        }
                        else if (item.AvailableStock == 0)
                        {
                            <span class="badge badge--danger">Out of stock — wait for restock or remove</span>
                        }
                        else if (item.RequiresRx)
                        {
                            <span class="badge badge--rx">Rx required</span>
                        }
                        else
                        {
                            <span class="badge badge--stock">In stock</span>
                        }
                    </div>

                    <div class="qty-stepper">
                        <button type="button" class="qty-minus"
                                aria-label="Decrease quantity"
                                @(item.Quantity <= 1 ? "disabled" : "")>&minus;</button>
                        <input type="number" class="qty-input"
                               value="@item.Quantity"
                               min="1"
                               max="@(item.Quantity + item.AvailableStock)"
                               aria-label="Quantity" />
                        <button type="button" class="qty-plus"
                                aria-label="Increase quantity"
                                @(item.AvailableStock <= 0 ? "disabled" : "")>+</button>
                    </div>

                    <div class="cart-item__price">
                        <span class="line-total">৳@item.LineTotal.ToString("0")</span>
                        <button type="button" class="cart-item__remove">Remove</button>
                    </div>
                </article>
            }
        </section>

        <aside class="order-summary" id="orderSummary">
            <h2>Order summary</h2>

            <div class="order-summary__row">
                <span>Subtotal</span>
                <span id="summarySubtotal">৳@Model.Sum(i => i.LineTotal).ToString("0")</span>
            </div>
            <div class="order-summary__row">
                <span>Delivery charge</span>
                <span class="muted">Calculated at checkout</span>
            </div>
            <div class="order-summary__row order-summary__row--total">
                <span>Estimated total</span>
                <span id="summaryTotal">৳@Model.Sum(i => i.LineTotal).ToString("0")</span>
            </div>

            @{
                var hasBlockedItems = Model.Any(i => i.IsBlockedFromCheckout);
            }

            @if (hasBlockedItems)
            {
                <div class="cart-checkout-block" id="checkoutBlockBanner">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                    <span>Remove expired, near-expiry, or out-of-stock items to proceed.</span>
                </div>
                <button type="button" class="btn btn--pine order-summary__cta"
                        id="checkoutBtn" disabled
                        style="opacity:0.5; cursor:not-allowed;">
                    Proceed to checkout &rarr;
                </button>
            }
            else
            {
                <a class="btn btn--pine order-summary__cta"
                   href="/Checkout" id="checkoutBtn">
                    Proceed to checkout &rarr;
                </a>
            }

            <p class="rx-note" id="rxNote"
               @(Model.Any(i => i.RequiresRx) ? "" : "hidden")>
                <span id="rxNoteCount">@Model.Count(i => i.RequiresRx)</span>
                item<span id="rxNotePlural">@(Model.Count(i => i.RequiresRx) == 1 ? "" : "s")</span>
                in your cart require<span id="rxNoteVerb">@(Model.Count(i => i.RequiresRx) == 1 ? "s" : "")</span>
                a prescription. You'll be asked to upload it at checkout.
            </p>
        </aside>
    </div>

    <div class="cart-empty" id="cartEmpty" hidden>
        <p>Your cart is empty.</p>
        <a class="btn btn--outline" href="/Medicines">Browse medicines</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
}
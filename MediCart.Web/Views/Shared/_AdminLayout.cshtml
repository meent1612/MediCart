@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsAction(string action) => string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MediCart Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">

    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-sidebar__brand">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                <div>
                    <span class="admin-sidebar__brand-name">MediCart</span>
                    <span class="admin-sidebar__brand-tag">Admin</span>
                </div>
            </div>

            <nav class="admin-nav" aria-label="Admin">
                <a href="~/Admin/Dashboard" class="admin-nav__link @(IsAction("Dashboard") ? "is-active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    Dashboard
                </a>

                <span class="admin-nav__label">Catalogue</span>
                <a href="~/Admin/Medicines" class="admin-nav__link @(IsAction("Medicines") ? "is-active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    Medicines
                </a>
                <a href="~/Admin/Categories" class="admin-nav__link @(IsAction("Categories") ? "is-active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="14" rx="1.5"/><path d="M3 9h18"/></svg>
                    Categories &amp; types
                </a>

                <span class="admin-nav__label">Orders</span>
                <a href="~/Admin/IncomingOrders" class="admin-nav__link @(IsAction("IncomingOrders") ? "is-active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h18M6 7v12a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7M9 11h6"/></svg>
                    Incoming orders
                </a>
                <a href="~/Admin/FlaggedOrders" class="admin-nav__link @(IsAction("FlaggedOrders") ? "is-active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 21V4a1 1 0 0 1 1-1h10l4 4v9a1 1 0 0 1-1 1H6"/></svg>
                    Flagged orders
                </a>

                <span class="admin-nav__label">Inventory</span>
                <a href="~/Admin/StockExpiry" class="admin-nav__link @(IsAction("StockExpiry") ? "is-active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                    Stock &amp; expiry
                </a>

                <span class="admin-nav__label">System</span>
                <a href="~/Admin/AuditLog" class="admin-nav__link @(IsAction("AuditLog") ? "is-active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 3H5a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9l-6-6Z"/><path d="M13 3v6h6"/></svg>
                    Audit log
                </a>
                <a href="~/Admin/ContactMessages" class="admin-nav__link @(IsAction("ContactMessages") ? "is-active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
                    Contact messages
                </a>
            </nav>

            <a href="~/Admin/Profile" class="admin-sidebar__profile @(IsAction("Profile") ? "is-active" : "")">
                <span class="admin-avatar admin-avatar--sm">MK</span>
                <span class="admin-sidebar__profile-text">
                    <strong>Md. Kayes</strong>
                    <small>View profile</small>
                </span>
            </a>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <button type="button" class="admin-topbar__burger" id="sidebarToggle" aria-label="Toggle menu" aria-expanded="false">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
                </button>
                <h1 class="admin-topbar__title">@ViewData["Title"]</h1>
                <div class="admin-topbar__actions">
                    <a href="~/Admin/Profile" class="admin-topbar__user">
                        <span class="admin-avatar admin-avatar--sm">MK</span>
                        <span>Md. Kayes &middot; Admin</span>
                    </a>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="toast" id="toast" role="status" aria-live="polite">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
        <span class="toast__text"></span>
    </div>

    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
